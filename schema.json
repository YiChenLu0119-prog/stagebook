{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stagebook v1 files",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/show"
    },
    {
      "$ref": "#/$defs/song"
    }
  ],
  "$defs": {
    "xy": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "c1": {
          "$ref": "#/$defs/xy"
        },
        "c2": {
          "$ref": "#/$defs/xy"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "dependentRequired": {
        "c1": [
          "c2"
        ],
        "c2": [
          "c1"
        ]
      }
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 2
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "label",
        "color"
      ]
    },
    "area": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "points": {
          "$ref": "#/$defs/path"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "points"
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "kind": {
          "enum": [
            "gate",
            "mark"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "y"
      ]
    },
    "stage": {
      "type": "object",
      "properties": {
        "audience": {
          "enum": [
            "north",
            "south",
            "east",
            "west"
          ]
        },
        "boundary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "backstage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "boundary",
        "backstage",
        "walls",
        "anchors",
        "audience"
      ]
    },
    "move": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entityId": {
          "type": "string"
        },
        "points": {
          "$ref": "#/$defs/path"
        },
        "gateId": {
          "type": "string"
        },
        "startOffset": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "entityId",
        "points"
      ]
    },
    "cue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "stopAfter": {
          "type": "boolean"
        },
        "moves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/move"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "at",
        "duration",
        "moves"
      ]
    },
    "lyric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "text"
      ]
    },
    "annotation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "entityIds",
        "notes"
      ]
    },
    "song": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "steps",
            "timed"
          ]
        },
        "audio": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "originalName": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ]
            }
          ]
        },
        "duration": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "castIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "propIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initial": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/xy"
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "lyrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lyric"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "mode",
        "castIds",
        "propIds",
        "initial",
        "cues",
        "lyrics",
        "annotations"
      ]
    },
    "show": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "pauseAtSteps": {
          "type": "boolean"
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "songs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "path"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "stage",
        "actors",
        "props",
        "songs"
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "stagebook-library"
        },
        "version": {
          "const": 1
        },
        "workspace": {
          "type": "object",
          "properties": {
            "showId": {
              "type": "string"
            },
            "songId": {
              "type": "string"
            }
          },
          "required": [
            "showId",
            "songId"
          ]
        },
        "shows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "path"
            ]
          }
        }
      },
      "required": [
        "format",
        "version",
        "shows"
      ]
    }
  }
}
